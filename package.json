{
  "name": "forme-fit-platform",
  "version": "1.0.0",
  "private": true,
  "author": "Maverick Technologies",
  "description": "Forme: fit intelligence platform for fashion retailers. Size API, embeddable widget, merchant console and analytics.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:pg": "node -e \"process.env.FORME_TEST_DB='pglite:';require('node:child_process').execFileSync(process.execPath,['--test'],{stdio:'inherit',env:process.env})\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
